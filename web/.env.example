# Copy to web/.env.local (git-ignored) and fill in. Only the ANON key — never the service_role key.
VITE_SUPABASE_URL=https://qtxxhfgqfyuiqflxtcol.supabase.co
VITE_SUPABASE_ANON_KEY=
# Local stack instead (after `npx supabase start`): URL http://127.0.0.1:54321 + the local anon key it prints.

# 1 = the plans page «اشترك» writes a trial (provider 'mock') subscription. Set 0 before launch.
VITE_TRIAL_SUBSCRIBE=1
# Google Play listing once published; empty = «قريبًا» badge.
VITE_PLAY_STORE_URL=
# 1 = the teacher speaks with the AI server's voice, through the Supabase function
# `ai-speak` (the AI server URL is the AI_BASE_URL Supabase secret — never here).
# Any failure falls back to the browser's voice. 0/empty = browser voice only.
VITE_AI_VOICE=0
# 1 = the live lesson runs on the AI teacher server's /agent/* state machine (ai/API_web.md),
# called straight from the browser (CORS allows gharsah.pages.dev only; localhost needs the
# AI developer to add it to MANARA_EXTRA_CORS_ORIGINS). Any server failure → today's built-in
# lesson. 0/empty = the built-in lesson exactly as before (VITE_AI_VOICE still applies to it).
VITE_AI_AGENT=0
# The AI server's public base URL (not a secret — no key is sent).
VITE_AI_BASE_URL=https://manara-backend-dev.onrender.com
# A separate recitation-verification model — NOT needed (2026-10-04): the AI server's own
# /agent/score-recitation (Modal Quran model, Groq fallback) scores every recitation and
# decides word feedback; /agent/actions/verify is a hadith-project check, not a recitation
# one. Leave empty (src/lesson/voice/recitationVerifier.ts).
VITE_VERIFY_URL=
# The AI-server teacher's voice is picked by the server per lang + gender (/speak/status) —
# nothing to set here. The built-in lesson's voice goes through the ai-speak function: its
# en / id voices are the secrets VOICE_ID_EN_M / VOICE_ID_EN_F / VOICE_ID_ID_M / VOICE_ID_ID_F
# (npx supabase secrets set …).
