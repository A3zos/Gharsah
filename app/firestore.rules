rules_version = '2';

// غَرْسة — Firestore security rules.
// Default: everything is denied. Only the paths matched below are reachable.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid
        && request.auth.token.get('firebase', {}).get('sign_in_provider', '') != 'anonymous';
    }
    function isDevice() {
      return signedIn() && request.auth.token.get('firebase', {}).get('sign_in_provider', '') == 'anonymous';
    }

    // parents/{uid} — the parent's own profile. Only that parent can read/write it.
    match /parents/{uid} {
      function validName(d) { return d.name is string && d.name.size() > 0 && d.name.size() <= 100; }

      allow read: if isOwner(uid);

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'role'])
        && validName(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.role == 'parent';

      // name/email may change; role and createdAt are fixed.
      allow update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['name', 'email', 'createdAt', 'role'])
        && validName(request.resource.data)
        && request.resource.data.role == resource.data.role
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if isOwner(uid);

      // parents/{uid}/children/{childId} — the parent's children (07–11).
      // Owner-only; every client field typed and bounded; owner and createdAt
      // fixed. Server-only fields — `pairing` (issued by the createPairingCode
      // / revokePairingCode Functions), `linkedDeviceUid` (claimPairingCode)
      // and `stats` (progress triggers) — can never be written by a client.
      match /children/{childId} {
        function ch() { return request.resource.data; }
        function dayOk(sched, d) {
          return !(d in sched.custom)
            || (sched.custom[d] is int && sched.custom[d] >= 0 && sched.custom[d] < 1440);
        }
        function validSchedule(sched) {
          return sched is map
            && sched.keys().hasOnly(['days', 'time', 'custom', 'duration', 'reminder'])
            && sched.keys().hasAll(['days', 'time', 'custom', 'duration', 'reminder'])
            && sched.days is list && sched.days.size() >= 1 && sched.days.size() <= 7
            && sched.days.hasOnly(['sat', 'sun', 'mon', 'tue', 'wed', 'thu', 'fri'])
            && sched.time is int && sched.time >= 0 && sched.time < 1440
            && sched.custom is map
            && sched.custom.keys().hasOnly(['sat', 'sun', 'mon', 'tue', 'wed', 'thu', 'fri'])
            && dayOk(sched, 'sat') && dayOk(sched, 'sun') && dayOk(sched, 'mon')
            && dayOk(sched, 'tue') && dayOk(sched, 'wed') && dayOk(sched, 'thu')
            && dayOk(sched, 'fri')
            && sched.duration in [30, 45, 60]
            && sched.reminder is bool;
        }
        function validProfile() {
          return ch().name is string && ch().name.size() >= 1 && ch().name.size() <= 40
            && ch().age is int && ch().age >= 8 && ch().age <= 13
            && ch().gender in ['girl', 'boy']
            && ch().avatar in ['g1', 'g2', 'g3', 'g4', 'g5', 'b1', 'b2', 'b3', 'b4']
            && validSchedule(ch().schedule);
        }

        allow read: if isOwner(uid);
        // The child's own linked device (set by claimPairingCode) may read
        // this one document — never list, never write.
        allow get: if isDevice() && resource.data.get('linkedDeviceUid', '') == request.auth.uid;
        allow create: if isOwner(uid)
          && exists(/databases/$(database)/documents/parents/$(uid))
          && ch().keys().hasOnly(['name', 'age', 'gender', 'avatar', 'schedule', 'ownerUid', 'createdAt'])
          && ch().keys().hasAll(['name', 'age', 'gender', 'avatar', 'schedule', 'ownerUid', 'createdAt'])
          && validProfile()
          && ch().ownerUid == uid
          && ch().createdAt == request.time;
        // Only the profile fields may change; everything else is locked.
        allow update: if isOwner(uid)
          && ch().diff(resource.data).affectedKeys()
               .hasOnly(['name', 'age', 'gender', 'avatar', 'schedule'])
          && validProfile();
        allow delete: if isOwner(uid);

        // The child's linked device (claimPairingCode) — checked against the
        // parent's child doc on every write.
        function linkedDevice() {
          return isDevice()
            && get(/databases/$(database)/documents/parents/$(uid)/children/$(childId))
                 .data.get('linkedDeviceUid', '') == request.auth.uid;
        }

        // progress/{lessonId} — lesson checkpoints written by the child device
        // (LessonAgent). Stats are derived from these by a Cloud Function, so
        // the device can never write totals directly.
        match /progress/{lessonId} {
          function p() { return request.resource.data; }
          function strList(l, max) { return l is list && l.size() <= max; }
          function validProgress() {
            return lessonId.matches('^[a-z0-9-]{1,64}$')
              && p().keys().hasOnly(['lessonId', 'stepIndex', 'doneRefs', 'surahsCompleted',
                   'hadithDone', 'projectAssigned', 'reportedProject', 'completed',
                   'startedAt', 'updatedAt'])
              && p().keys().hasAll(['lessonId', 'stepIndex', 'doneRefs', 'surahsCompleted',
                   'hadithDone', 'completed', 'startedAt', 'updatedAt'])
              && p().lessonId == lessonId
              && p().stepIndex is int && p().stepIndex >= 0 && p().stepIndex < 100
              && strList(p().doneRefs, 300)
              && strList(p().surahsCompleted, 114)
              && strList(p().hadithDone, 20)
              && (!('projectAssigned' in p()) || p().projectAssigned == null
                  || (p().projectAssigned is string && p().projectAssigned.size() <= 64))
              && (!('reportedProject' in p()) || p().reportedProject == null
                  || (p().reportedProject is string && p().reportedProject.size() <= 64))
              && p().completed is bool
              && p().startedAt is timestamp
              && p().updatedAt == request.time;
          }
          allow read: if isOwner(uid) || linkedDevice();
          allow create: if linkedDevice() && validProgress() && p().startedAt == request.time;
          allow update: if linkedDevice() && validProgress()
            && p().startedAt == resource.data.startedAt
            // A finished lesson stays finished.
            && (resource.data.completed == false || p().completed == true);
          allow delete: if isOwner(uid);
        }

        // submissions/{submissionId} — the project report (frame 22). The
        // audio itself is in Storage at exactly storagePath.
        match /submissions/{submissionId} {
          function sb() { return request.resource.data; }
          allow read, delete: if isOwner(uid);
          allow create: if linkedDevice()
            && submissionId.matches('^[A-Za-z0-9_-]{1,64}$')
            && sb().keys().hasOnly(['projectId', 'lessonId', 'storagePath', 'durationMs', 'createdAt'])
            && sb().keys().hasAll(['projectId', 'lessonId', 'storagePath', 'durationMs', 'createdAt'])
            && sb().projectId is string && sb().projectId.matches('^[a-z0-9-]{1,64}$')
            && sb().lessonId is string && sb().lessonId.matches('^[a-z0-9-]{1,64}$')
            && (sb().storagePath == 'recordings/' + uid + '/' + childId + '/' + submissionId + '.m4a'
                || sb().storagePath == 'recordings/' + uid + '/' + childId + '/' + submissionId + '.wav')
            && sb().durationMs is int && sb().durationMs >= 1000 && sb().durationMs <= 180000
            && sb().createdAt == request.time;
          allow update: if false;
        }
      }

      // parents/{uid}/subscription/current — the parent's plan.
      // MOCK Play purchase for now: the client writes it, but only in this exact
      // shape, marked provider 'mock', and never longer than the plan allows.
      // TODO(phase-c): real Google Play Billing — a server verifies the purchase
      // token and writes this doc with the Admin SDK; then change the client
      // rule to `allow write: if false;`.
      match /subscription/{docId} {
        function sub() { return request.resource.data; }
        function periodDays(plan) { return plan == 'annual' ? 366 : 31; }
        // A renewal may extend from the current expiry if it is still in the future.
        function base() {
          return resource == null || resource.data.expiresAt < request.time
            ? request.time : resource.data.expiresAt;
        }
        function validSubscription() {
          return docId == 'current'
            && exists(/databases/$(database)/documents/parents/$(uid))
            && sub().keys().hasOnly(['plan', 'status', 'provider', 'startedAt', 'expiresAt'])
            && sub().keys().hasAll(['plan', 'status', 'provider', 'startedAt', 'expiresAt'])
            && sub().plan in ['annual', 'monthly']
            && sub().status == 'active'
            && sub().provider == 'mock'
            && sub().startedAt == request.time
            && sub().expiresAt is timestamp
            && sub().expiresAt > request.time
            && sub().expiresAt <= base() + duration.value(periodDays(sub().plan), 'd');
        }

        allow read: if isOwner(uid) && docId == 'current';
        allow create, update: if isOwner(uid) && validSubscription();
        allow delete: if false;
      }
    }

    // childSessions/{deviceUid} — written only by Cloud Functions. The device
    // may read its own session (relaunch: still linked, or revoked?).
    match /childSessions/{deviceUid} {
      allow get: if isDevice() && request.auth.uid == deviceUid;
    }

    // leaderboard/current — the anonymous weekly board, written only by the
    // scheduled Function. It holds rank + points rows only (no uid, child id,
    // parent id, name or avatar); a child's own standing lives in its own
    // child doc (`leader`). Child devices may get this one doc; no list/write.
    match /leaderboard/{docId} {
      allow get: if isDevice() && docId == 'current';
    }

    // pairingCodes/{code}, rateLimits/{deviceUid}: Cloud Functions (Admin SDK)
    // only — no client can read, list or write them. No match block on
    // purpose: default deny.
  }
}
