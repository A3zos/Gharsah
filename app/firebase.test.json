{
  "_comment": "Test-only emulator ports (separate from firebase.json dev ports) so test runs never collide with a running dev emulator. Use: firebase emulators:exec -c firebase.test.json ...",
  "firestore": {
    "rules": "firestore.rules"
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8180
    },
    "storage": {
      "port": 9299
    },
    "functions": {
      "port": 5101
    },
    "hub": {
      "port": 4500
    },
    "logging": {
      "port": 4600
    },
    "eventarc": {
      "port": 9399
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "*.log",
        "lib/test/**",
        "test/**"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ]
}
