# ── Root ignore for the Gharsah monorepo ──
# (app/ also has Flutter's own .gitignore; android/ has its own for keystores)

# Build output left at the root from before the monorepo move
/build/

# Logs
*.log

# Secrets — never commit (only the *.example templates are tracked)
.env
.env.*
!.env.example
# Placeholder values for the stubbed Playwright build (no real keys)
!web/.env.e2e
# Flutter --dart-define-from-file values
app/env/*.json
!app/env/*.example.json
# Supabase local state
supabase/.temp/
supabase/.branches/
supabase/functions/.env
*service-account*.json
*serviceAccount*.json
*-firebase-adminsdk-*.json
*.jks
*.keystore
key.properties

# Node tooling
node_modules/

# Python (ai/)
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# Model weights / large binaries (share via release or storage, not git)
*.onnx
*.tflite
*.pt
*.bin
*.nemo

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# Firebase client config (being replaced by Supabase) — kept locally, not tracked
app/android/app/google-services.json
app/lib/firebase_options.dart
